rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'email'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256;
      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // CONTACTS COLLECTION
    match /contacts/{contactId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(contactId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'name', 'fullPhone'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 128
        && request.resource.data.fullPhone is string && request.resource.data.fullPhone.size() <= 32;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.name is string && request.resource.data.name.size() <= 128;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // CONTACT LISTS COLLECTION
    match /contactLists/{listId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(listId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'name'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 128;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.name is string && request.resource.data.name.size() <= 128;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // TEMPLATES COLLECTION
    match /templates/{templateId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(templateId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'name', 'body'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 128
        && request.resource.data.body is string && request.resource.data.body.size() <= 4096;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.name is string && request.resource.data.name.size() <= 128;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // BROADCASTS COLLECTION
    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(broadcastId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'title', 'status'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 256;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // BROADCAST LOGS COLLECTION
    match /broadcastLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(logId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['broadcastId', 'userId', 'phone', 'status']);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
